{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superlooper.local/schemas/execution-manifest.schema.json",
  "title": "SUPERLOOPER Execution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "granularity", "context", "dag"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "granularity": {
      "const": "module"
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "prd_path",
        "design_docs_path",
        "module_split_path",
        "agents_path",
        "runtime_agents_path",
        "outputs_path",
        "merged_path",
        "reports_path"
      ],
      "allOf": [
        {
          "if": {
            "required": ["platform_registration"]
          },
          "then": {
            "not": {
              "required": ["registered_agents_path"]
            }
          },
          "else": {
            "required": ["registered_agents_path"]
          }
        }
      ],
      "properties": {
        "prd_path": { "type": "string", "minLength": 1 },
        "design_docs_path": { "type": "string", "minLength": 1 },
        "module_split_path": { "type": "string", "minLength": 1 },
        "agents_path": { "type": "string", "minLength": 1 },
        "runtime_agents_path": { "type": "string", "minLength": 1 },
        "registered_agents_path": { "type": "string", "minLength": 1 },
        "platform_registration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform"],
          "properties": {
            "platform": { "const": "codex" }
          }
        },
        "outputs_path": { "type": "string", "minLength": 1 },
        "merged_path": { "type": "string", "minLength": 1 },
        "reports_path": { "type": "string", "minLength": 1 }
      }
    },
    "dag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "agent", "depends_on", "payload"],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "id": { "pattern": "^mod_" }
                  },
                  "required": ["id"]
                },
                "then": {
                  "properties": {
                    "payload": { "type": "object", "minProperties": 1 }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": { "const": "task_code_review" }
                  },
                  "required": ["id"]
                },
                "then": {
                  "properties": {
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "workspace_root",
                        "task_id",
                        "outputs_path",
                        "reports_path",
                        "execution_manifest_path",
                        "design_docs_path",
                        "module_split_path"
                      ],
                      "properties": {
                        "workspace_root": { "const": "." },
                        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                        "outputs_path": { "type": "string", "minLength": 1 },
                        "reports_path": { "type": "string", "minLength": 1 },
                        "execution_manifest_path": { "type": "string", "minLength": 1 },
                        "design_docs_path": { "type": "string", "minLength": 1 },
                        "module_split_path": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": { "const": "task_merge" }
                  },
                  "required": ["id"]
                },
                "then": {
                  "properties": {
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "workspace_root",
                        "task_id",
                        "manifest_path",
                        "outputs_dir",
                        "merged_dir",
                        "reports_dir",
                        "code_review_report_path"
                      ],
                      "properties": {
                        "workspace_root": { "const": "." },
                        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                        "manifest_path": { "type": "string", "minLength": 1 },
                        "outputs_dir": { "type": "string", "minLength": 1 },
                        "merged_dir": { "type": "string", "minLength": 1 },
                        "reports_dir": { "type": "string", "minLength": 1 },
                        "code_review_report_path": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": { "const": "task_integration_test" }
                  },
                  "required": ["id"]
                },
                "then": {
                  "properties": {
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "workspace_root",
                        "task_id",
                        "merged_path",
                        "reports_path",
                        "prd_path",
                        "design_docs_path",
                        "execution_manifest_path",
                        "merge_report_path",
                        "test_workspace_path"
                      ],
                      "properties": {
                        "workspace_root": { "const": "." },
                        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                        "merged_path": { "type": "string", "minLength": 1 },
                        "reports_path": { "type": "string", "minLength": 1 },
                        "prd_path": { "type": "string", "minLength": 1 },
                        "design_docs_path": { "type": "string", "minLength": 1 },
                        "execution_manifest_path": { "type": "string", "minLength": 1 },
                        "merge_report_path": { "type": "string", "minLength": 1 },
                        "test_workspace_path": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": { "const": "task_apply_to_workspace" }
                  },
                  "required": ["id"]
                },
                "then": {
                  "properties": {
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "workspace_root",
                        "task_id",
                        "merged_dir",
                        "reports_dir",
                        "merge_report_path",
                        "test_report_path"
                      ],
                      "properties": {
                        "workspace_root": { "const": "." },
                        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
                        "merged_dir": { "type": "string", "minLength": 1 },
                        "reports_dir": { "type": "string", "minLength": 1 },
                        "merge_report_path": { "type": "string", "minLength": 1 },
                        "test_report_path": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(mod_[a-z][a-z0-9_]*|task_[a-z0-9_]+)$",
                "not": { "enum": ["mod_feature_a", "mod_feature_b", "mod_module_a", "mod_module_b"] }
              },
              "agent": {
                "type": "string",
                "pattern": "^(module_[a-z][a-z0-9_]*|code-reviewer|system_merger|tester|workspace_applier)$"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "payload": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "object", "minProperties": 1 }
                ]
              }
            }
          }
        }
      }
    }
  }
}
