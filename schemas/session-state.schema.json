{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superlooper.local/schemas/session-state.schema.json",
  "title": "SUPERLOOPER Session State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "workspace_root",
    "requirement_path",
    "current_phase",
    "phase_status",
    "generated_files",
    "reports",
    "script_events",
    "last_command",
    "last_error",
    "next_actions",
    "project_mode",
    "workflow_mode",
    "project_category",
    "project_version",
    "project_root",
    "project_initialized",
    "initialization_report",
    "execution_summary_status",
    "execution_summary_report",
    "loop_policy",
    "loop_state",
    "requirement_alignment_report",
    "requirement_alignment_passed",
    "prd_revision",
    "ui_revision",
    "ui_status",
    "ui_output_dir",
    "ui_artifacts_validated",
    "design_revision",
    "change_request_count",
    "active_feedback_report",
    "change_impact_report",
    "invalidated_artifacts",
    "rollback_target_phase",
    "last_user_input_text",
    "last_user_canonical_action",
    "pending_user_choice"
  ],
  "properties": {
    "session_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "workspace_root": { "type": "string", "minLength": 1 },
    "requirement_path": { "type": "string" },
    "current_phase": { "enum": ["init", "prd", "ui_design", "design", "initialization", "run", "requirement_alignment", "report"] },
    "phase_status": { "enum": ["pending", "running", "waiting_review", "passed", "failed", "blocked"] },
    "generated_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reports": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "script_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["script", "status", "idempotency_key"],
        "properties": {
          "script": { "type": "string", "minLength": 1 },
          "status": { "enum": ["started", "completed", "failed"] },
          "idempotency_key": { "type": "string", "minLength": 1 }
        }
      }
    },
    "last_command": { "type": ["string", "null"] },
    "last_error": { "type": ["string", "null"] },
    "next_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "project_mode": { "enum": ["greenfield", "brownfield", "brownfield-selective", "single_change", "ambiguous"] },
    "workflow_mode": { "enum": ["standard", "strict_review"] },
    "project_category": { "type": ["string", "null"], "enum": ["java", "go", "springboot", "pom", "lua", null] },
    "project_version": {
      "type": ["string", "null"],
      "enum": [
        "jdk-8",
        "jdk-11",
        "jdk-17",
        "go-1.25",
        "springboot-2.x",
        "springboot-3.x",
        "maven-3.5.x",
        "maven-3.9.x",
        "lua-4.x",
        "lua-5.x",
        null
      ]
    },
    "project_root": { "type": ["string", "null"] },
    "project_initialized": { "type": "boolean" },
    "initialization_report": { "type": ["string", "null"] },
    "execution_summary_status": { "enum": ["NOT_STARTED", "READY_FOR_APPROVAL", "APPROVED", "REJECTED", "BLOCKED"] },
    "execution_summary_report": { "type": ["string", "null"] },
    "loop_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_auto_loop_per_phase"],
      "properties": {
        "max_auto_loop_per_phase": { "type": "integer", "minimum": 0 }
      }
    },
    "loop_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_loop_target_phase", "loop_count_by_phase", "last_alignment_status", "last_feedback_report"],
      "properties": {
        "current_loop_target_phase": { "type": ["string", "null"], "enum": ["prd", "ui_design", "design", "initialization", "run", "requirement_alignment", null] },
        "loop_count_by_phase": {
          "type": "object",
          "propertyNames": {
            "enum": ["prd", "ui_design", "design", "initialization", "run", "requirement_alignment"]
          },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "last_alignment_status": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "BLOCKED", null] },
        "last_feedback_report": { "type": ["string", "null"] }
      }
    },
    "requirement_alignment_report": { "type": ["string", "null"] },
    "requirement_alignment_passed": { "type": "boolean" },
    "prd_revision": { "type": "integer", "minimum": 0 },
    "ui_revision": { "type": "integer", "minimum": 0 },
    "ui_status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "READY_FOR_REVIEW", "CHANGES_REQUESTED", "APPROVED", "BLOCKED", "FAILED"] },
    "ui_output_dir": { "type": ["string", "null"] },
    "ui_artifacts_validated": { "type": "boolean" },
    "design_revision": { "type": "integer", "minimum": 0 },
    "change_request_count": { "type": "integer", "minimum": 0 },
    "active_feedback_report": { "type": ["string", "null"] },
    "change_impact_report": { "type": ["string", "null"] },
    "invalidated_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rollback_target_phase": { "type": ["string", "null"], "enum": ["prd", "ui_design", "design", "initialization", "run", "requirement_alignment", null] },
    "last_user_input_text": { "type": ["string", "null"] },
    "last_user_canonical_action": { "type": ["string", "null"] },
    "pending_user_choice": { "type": ["object", "null"] }
  }
}
